# MemFlow Relay — Environment Variables

# ──────────────────────────────────────────────
# LamoonAGI / MemFlow credentials
# ──────────────────────────────────────────────

# Your LamoonAGI API key (lago_ prefix format).
# Used ONLY to authenticate requests to api.lamoonagi.com.
# Never sent to Google.
MEMFLOW_API_KEY=lago_your_key_here

# ──────────────────────────────────────────────
# Gemini credentials
# ──────────────────────────────────────────────

# Your Google Gemini API key.
# Used ONLY for requests to generativelanguage.googleapis.com.
# Never sent to LamoonAGI.
GEMINI_API_KEY=your_gemini_key_here

# ──────────────────────────────────────────────
# MemFlow Relay configuration
# ──────────────────────────────────────────────

# Operating mode: shadow | safe | optimize
# shadow   — observe only, forward original request unchanged
# safe     — optimize when confidence is high, fallback to original
# optimize — always attempt optimization
MEMFLOW_MODE=shadow

# MemFlow optimizer API base URL
MEMFLOW_API_URL=https://api.lamoonagi.com

# Local proxy port (binds to 127.0.0.1 only)
MEMFLOW_PORT=8765

# Fail-open: if true, forward original request when optimizer fails
MEMFLOW_FAIL_OPEN=true

# Telemetry level: off | metrics_only | diagnostic
# metrics_only (default) — aggregate counts and token buckets only, NO prompt content
# diagnostic — adds anonymized request structure metadata
MEMFLOW_TELEMETRY=metrics_only
